begin model
begin parameters
  k_bind 0.361
  k_unbind 0.028
  k_mod 0.127
  A0 131
  B0 50
  k_expr 2 * k_bind
end parameters
begin molecule types
  A(a)
  B(a~0~1,b~0~1)
  C(a,b~0~1)
end molecule types
begin seed species
  A(a) A0
  B(a~0,b~0) B0
  C(a,b~0) 10
end seed species
begin observables
  Molecules Total_A A()
  Molecules Bound_AB A(a!1).B(a!1)
end observables
begin functions
  f_rate() = k_mod * 0.5
end functions
begin reaction rules
  A(a) + B(a) <-> A(a!1).B(a!1) k_bind, k_unbind
end reaction rules
end model