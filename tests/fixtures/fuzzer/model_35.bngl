begin model
begin parameters
  k_bind 0.333
  k_unbind 0.083
  k_mod 0.091
  A0 99
  B0 40
  k_expr 2 * k_bind
end parameters
begin molecule types
  A(a~0~1)
  B(a~0~1,b~0~1)
end molecule types
begin seed species
  A(a~0) A0
  B(a~0,b~0) B0
end seed species
begin observables
  Molecules Total_A A()
  Molecules Active_A A(a~1)
end observables
begin functions
  f_rate() = k_mod * 0.5
end functions
begin reaction rules
  A(a~0) -> A(a~1) k_expr
end reaction rules
end model